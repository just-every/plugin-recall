  "history": {
    "eligibility": "owner statements strictly before the decision time (parsed timestamps, microseconds), not already in the current session context, not the reply being predicted; each distinct normalised text is one item (x1 corpus, item id = o + sha1(normalised text)[:11])",
    "item_text": "full owner statement text"
  },
  "query": {
    "mode": "stop-time (the agent turn)",
    "situation": {
      "format": "SITUATION (conversation so far, newest last):\n\n<turn>\n\n<turn>\n\nASSISTANT (latest message): <clip(assistant_text, 1500)>",
      "turns": "the last 2 conversation turns before the assistant message, each rendered \"OWNER: <clip(text, 500)>\" or \"ASSISTANT: <clip(text, 500)>\"; zero to two turns if fewer exist",
      "clip_rule": "trim; if length <= n keep, else text[0:n] with trailing whitespace trimmed + \" [...]\"",
      "never_contains": "the owner reply being predicted"
    },
    "embedding": {
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "text": "clip(situation, 6000)",
      "similarity": "cosine (unit vectors: dot product)"
    },
    "bm25": {
      "query": "tokenize(situation) (full text, no clip)",
      "docs": "tokenize(clip(item text, 4000)) over the eligible history only",
      "k1": 1.2,
      "b": 0.75,
      "idf": "ln(1 + (N - n + 0.5) / (n + 0.5)) with N and n counted over the eligible history only",
      "tokenizer": "lowercase; matches [a-z0-9_$./-]{2,}; strip leading/trailing . / -; keep length >= 2; drop the stopword list in x1 lib/text.ts",
      "tie_break": "item id ascending"
    },
    "same_thread_list": "eligible items whose thread equals the current thread, newest first"
  },
  "prefilter": {
    "sources": [
      "embeddings: top 150 by cosine",
      "bm25: top 60",
      "same-thread newest: top 30"
    ],
    "union": "set union, deduplicated",
    "size_mean_104_cases": 198.39423076923092,
    "size_mean_live_30": 201.16666666666666
  },
  "d_generic": {
    "model": "gpt-6-luna",
    "endpoint": "POST /v1/decisions",
    "question_type": "predicate",
    "input": "the situation text",
    "one_question_per_prefilter_item": true,
    "instructions": "Past owner statement: \"<clip(item text, 260)>\"\nIs this past owner statement important for handling the situation above correctly?",
    "item_clip": {
      "chars": 260,
      "rule": "head clip with the \" [...]\" marker (trim; if longer than 260 keep the first 260 chars, trim trailing whitespace, append \" [...]\")"
    },
    "pack": {
      "max_questions_per_request": 200,
      "pack_size": 72,
      "note": "answers do not depend on packing or order (probe g); pack size only trades requests for latency; packs are sent concurrently"
    },
    "refusals": "an answer of type refusal is treated as unscored: the item is ranked after all scored items in the D list, in embedding order, and counted",
    "cost": "about $0.0000212 per question (measured), about $0.0044 per query live"
  },
  "fusion": {
    "type": "reciprocal rank fusion",
    "lists": [
      "E: full-history embedding rank",
      "B: full-history BM25 rank",
      "Dg: rank within the prefilter by D-generic score (descending), ties by E rank; refused items last in E order"
    ],
    "formula": "score(i) = w_e/(k+E(i)) + w_b/(k+B(i)) + w_dg/(k+Dg(i)), ranks 1-based",
    "k": 60,
    "w_e": 1,
    "w_b": 1,
    "w_dg": 2,
    "same_thread_list": "not used (same-thread recency variants did not win)",
    "candidates": "prefilter items only",
    "order": "score descending",
    "tie_break": "E rank ascending (then item position ascending)",
    "output_k": 5
  },
  "thresholds": {
